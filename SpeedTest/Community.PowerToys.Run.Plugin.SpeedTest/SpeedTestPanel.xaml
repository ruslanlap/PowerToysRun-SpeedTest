<Window x:Class="Community.PowerToys.Run.Plugin.SpeedTest.SpeedTestPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Speed Test" Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="OnKeyDown" Closed="OnClosed" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#121212" />
        <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2" />
        <SolidColorBrush x:Key="DimBrush" Color="#AAAAAA" />
        <SolidColorBrush x:Key="TrackBrush" Color="#505050" />
        <SolidColorBrush x:Key="AccentBrush" Color="#A9BFFF" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock Text="NETWORK SPEED TEST" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="Status" Text="Connecting…" Foreground="{DynamicResource DimBrush}"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,16" />
        <UniformGrid Columns="2">
            <StackPanel x:Name="DownloadDial" />
            <StackPanel x:Name="UploadDial" />
        </UniformGrid>
        <TextBlock x:Name="Summary" Foreground="{DynamicResource DimBrush}" TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" MinHeight="20" Margin="0,4,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="RunAgain" Content="Run again" Click="RunAgain_Click" IsEnabled="False" />
            <Button x:Name="Details" Content="Details" Click="Details_Click" IsEnabled="False" />
            <Button x:Name="Dismiss" Content="Cancel" Click="Dismiss_Click" />
        </StackPanel>
    </StackPanel>
</Window>
